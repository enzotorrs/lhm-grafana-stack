# Copie para a aba "Environment" do Dokploy (ou para um arquivo .env ao rodar localmente).

# IP:porta do LibreHardwareMonitor (Windows) ou do lhm-linux-agent (Linux/Proxmox).
# Várias máquinas: separe por vírgula. Senha diferente por máquina: http://usuario:senha@IP:8085
LHM_TARGETS=192.168.0.10:8085

# Só se você ativou autenticação no Remote Web Server do LHM.
LHM_USERNAME=
LHM_PASSWORD=

# Login do Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Porta do host para abrir o Grafana direto pela rede: http://IP-DO-SERVIDOR:3030
# (não use 3000: é a porta do painel do Dokploy).
GRAFANA_PORT=3030

# URL pela qual você acessa o Grafana (domínio do Dokploy ou http://IP-DO-SERVIDOR:3030/).
GRAFANA_ROOT_URL=http://192.168.0.20:3030/

# true = qualquer pessoa com o link vê os dashboards sem login (só leitura).
GRAFANA_ANONYMOUS_ACCESS=false

# Quanto tempo de histórico guardar.
PROMETHEUS_RETENTION=30d
